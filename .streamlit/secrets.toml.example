# Streamlit Secrets の設定例です。
# このファイルをコピーして `.streamlit/secrets.toml` を作成し、値を入れてください。
# `.streamlit/secrets.toml` は Git にコミットしないでください。
#
# 優先順位:
#   1. この Secrets ファイル（GEMINI_API_KEY）
#   2. 環境変数 GEMINI_API_KEY（`.env` 含む）
#   3. アプリのサイドバー手動入力

# GEMINI_API_KEY = "your_gemini_api_key_here"

# 一般ユーザー向けメンテナンス遮断（管理者はログイン可）
MAINTENANCE_MODE = false

# ホスト専用。一致した場合のみ管理者コントロールパネルが表示されます。
# ADMIN_USERNAME = "your_admin_username"
# ADMIN_PASSWORD = "your_admin_password"
